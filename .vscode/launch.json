{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BusGo web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build BusGo",
      "program": "${workspaceFolder}/bin/Debug/net10.0/BusGo.dll",
      "cwd": "${workspaceFolder}",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "http://0.0.0.0:5080" },
      "serverReadyAction": { "action": "openExternally", "pattern": "\\bNow listening on:\\s+(https?://\\S+)" }
    }
  ]
}
