# =================================================================
# BusGo Production Environment Variables Template
# Copy this file to .env and replace with your actual production values
# =================================================================

# Database Connection (Required)
# Format for SQL Server with SQL Authentication (Linux/Docker/Cloud):
BUS_TICKET_CONNECTION_STRING=Server=sql-server,1433;Database=BusTicketSaleSystem;User Id=sa;Password=YourStrongPassword!;TrustServerCertificate=True;Encrypt=False;
BUS_TICKET_MASTER_CONNECTION_STRING=Server=sql-server,1433;Database=master;User Id=sa;Password=YourStrongPassword!;TrustServerCertificate=True;Encrypt=False;

# Station Scope (Required for station admin)
STATION_LOCATION=Thái Nguyên

# ASP.NET Core Hosting Environment
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Logging
LOGGING__LOGDIRECTORY=/app/logs
LOGGING__RETAINDAYS=30

# Seed Configuration (Set to false on real production)
DATABASE__SEEDUPCOMINGTRIPS=false

# Default Owner Setup (Seed on initial start if no owner exists)
SECURITY__DEFAULTOWNER__USERNAME=owner
SECURITY__DEFAULTOWNER__EMAIL=owner@busgo.local
SECURITY__DEFAULTOWNER__FULLNAME=Station Owner
SECURITY__DEFAULTOWNER__PHONE=0988888888
SECURITY__DEFAULTOWNER__PASSWORD=ChangeThisPasswordInProduction!123

# Email Service via Brevo (Optional)
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=noreply@busgo.vn
EMAIL_SENDER_NAME=BusGo

# VNPay Payment Gateway (Optional)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=https://yourdomain.com/vnpay-return/
