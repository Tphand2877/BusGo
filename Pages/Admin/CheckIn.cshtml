@page
@model BusGo.Pages.Admin.CheckInModel
@{ ViewData["Title"] = T("Soát vé lên xe", "Boarding check-in"); }

<header class="page-header">
    <div>
        <p class="eyebrow">@T("Quầy soát vé tại bến", "Station boarding desk")</p>
        <h1>@T("Soát vé hành khách", "Check in a passenger")</h1>
        <p class="muted">@T("Quét mã QR / mã vạch trên vé bằng camera laptop hoặc nhập mã thủ công bên dưới.", "Scan ticket QR / barcode with laptop camera or enter code manually below.")</p>
    </div>
</header>
<partial name="_AdminValidation" />

<!-- Large Real-time Feedback Banner (Green / Yellow / Red) -->
<div id="scan-result-banner" class="scan-banner" hidden role="alert" aria-live="assertive">
    <div class="scan-banner-header">
        <h2 class="scan-banner-title"></h2>
        <p class="scan-banner-msg"></p>
    </div>
    <div class="scan-banner-details" hidden></div>
</div>

<!-- Camera Error Message -->
<div id="camera-error-message" class="alert error" hidden style="margin-bottom: 20px;"></div>

<!-- Scanner Toolbar & Camera Panel -->
<section class="card checkin-scanner-card" style="margin-bottom: 24px;">
    <div class="scanner-toolbar" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px;">
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <button type="button" id="btn-start-camera" class="button" style="background: var(--green); color: #fff;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="13" r="4" stroke="currentColor" stroke-width="1.8"/></svg>
                <span>@T("Quét bằng camera", "Scan with camera")</span>
            </button>
            <button type="button" id="btn-stop-camera" class="button secondary" style="display: none;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.8"/><path d="m15 9-6 6M9 9l6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                <span>@T("Tắt camera", "Turn off camera")</span>
            </button>
            <button type="button" id="btn-mirror-camera" class="button secondary" style="display: none;" title="@T("Lật ngược camera (Mirror)", "Mirror camera (Flip)")">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 7h12m0 0l-4-4m4 4l-4 4m-4 6H4m0 0l4 4m-4-4l4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="mirror-label">@T("Lật camera", "Mirror camera")</span>
            </button>
            <select id="camera-select" style="display: none; max-width: 240px; min-height: 42px;"></select>
        </div>
        <div>
            <button type="button" id="btn-sound-toggle" class="button secondary small" title="@T("Bật/tắt âm thanh", "Toggle sound")">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                <span class="sound-label">@T("Âm thanh: Bật", "Sound: On")</span>
            </button>
        </div>
    </div>

    <!-- Active Camera Panel (getUserMedia requires HTTPS or localhost) -->
    <div id="camera-scanner-panel" hidden style="margin-top: 20px; text-align: center;">
        <div style="max-width: 440px; margin: 0 auto; position: relative;">
            <div id="qr-reader" style="width: 100%; border-radius: 16px; overflow: hidden; background: #000; border: 2px solid var(--border-strong);"></div>
        </div>
        <p class="muted" style="font-size: 12px; margin-top: 10px;">@T("Hướng mã QR hoặc mã vạch trên vé về phía máy ảnh để tự động soát vé.", "Point the ticket QR code or barcode towards the camera for automatic check-in.")</p>
    </div>
</section>

<!-- Manual input fallback (auto-focuses, submits on Enter, clears after scan) -->
<form id="manual-checkin-form" method="get" class="card">
    <label for="manual-code-input" style="font-weight: 750;">@T("Nhập hoặc quét mã thủ công (Mã vé / Barcode)", "Enter or scan manually (Ticket code / Barcode)")</label>
    <div class="actions" style="margin-top: 10px;">
        <input id="manual-code-input" name="Code" value="@Model.Code" autocomplete="off" autofocus placeholder="@T("Ví dụ: TK-XXXXXXXX hoặc quét từ máy đọc USB", "E.g., TK-XXXXXXXX or scan with USB reader")" style="min-height: 46px; font-weight: 700; letter-spacing: .02em;" />
        <button type="submit">@T("Soát vé ngay", "Check in now")</button>
        <a class="button secondary" asp-page="CheckIn">@T("Xóa", "Clear")</a>
    </div>
    <p class="muted" style="font-size: 11px; margin: 8px 0 0;">@T("Hỗ trợ máy quét mã vạch USB cầm tay: máy quét sẽ tự động điền mã và gửi lệnh kiểm tra.", "Handheld USB barcode scanners supported: scans will auto-fill and submit instantly.")</p>
</form>

@if(Model.Ticket is {} t) {
<section class="card" style="margin-top: 24px;"><div class="page-header"><div><h2>@t.TicketCode</h2><p>@t.Route</p></div><span class="badge">@Value(t.Status)</span></div>
<div class="grid grid-3"><div><h3>@T("Hành khách", "Passenger")</h3><p>@t.PassengerName</p><p>@t.PassengerPhone</p></div><div><h3>@T("Hành trình", "Journey")</h3><p>@t.DepartureFormatted – @t.ArrivalFormatted</p><p>@t.LicensePlate · @Value(t.BusType)</p><p>@T("Ghế:", "Seats:") @t.SeatNumbers</p></div><div><h3>@T("Đối soát", "Settlement")</h3><p>@t.TotalPrice.ToString("N0") VND</p><p>@Value(t.PaymentStatus)</p><p>@T("Đặt lúc:", "Booked:") @t.BookingTimeFormatted</p></div></div>
@if(t.UsedAt.HasValue) { <p class="alert">@Format("Đã sử dụng / soát vé lúc {0}.", "Already used / checked in at {0}.", t.UsedAt.Value.ToLocalTime().ToString("g"))</p> }
@if(Model.CanCheckIn) { <form method="post" data-confirm="@T("Xác nhận hành khách này lên xe?", "Confirm that this passenger is boarding?")"><input asp-for="Code" type="hidden" /><button>@T("Xác nhận lên xe", "Confirm boarding check-in")</button></form> }
else { <p class="alert">@T("Vé này chưa đủ điều kiện lên xe. Vé phải đã thanh toán, đang hoạt động và chưa sử dụng.", "This ticket is not eligible for boarding. It must be paid, active and not already used.")</p> }
</section>
}

<style>
/* CheckIn Scanner Styles */
.scan-banner {
    padding: 20px 24px;
    border-radius: 16px;
    margin-bottom: 24px;
    animation: scanSlideDown 240ms cubic-bezier(0.2, 0, 0.25, 1);
    box-shadow: 0 16px 36px -6px rgba(0, 0, 0, 0.45);
}
@@keyframes scanSlideDown {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
}
.scan-banner-title {
    font-size: 20px;
    font-weight: 850;
    margin: 0 0 4px;
    letter-spacing: -.02em;
}
.scan-banner-msg {
    margin: 0;
    font-size: 13px;
    opacity: 0.92;
}
.scan-banner-details {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
}
.scan-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 8px 16px;
    font-size: 12px;
}
.scan-details-grid small {
    display: block;
    opacity: 0.75;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .05em;
}
.scan-details-grid strong {
    font-size: 13px;
}

/* Green Success */
.scan-success {
    background: light-dark(#15803d, #14532d);
    color: #ffffff;
    border: 2px solid light-dark(#22c55e, #4ade80);
}
/* Yellow Warning (Already used) */
.scan-alreadyused {
    background: light-dark(#b45309, #78350f);
    color: #ffffff;
    border: 2px solid light-dark(#f59e0b, #fbbf24);
}
/* Red Error (Invalid) */
.scan-invalid {
    background: light-dark(#b91c1c, #7f1d1d);
    color: #ffffff;
    border: 2px solid light-dark(#ef4444, #f87171);
}

#qr-reader video {
    object-fit: cover !important;
    border-radius: 14px;
}
#qr-reader.camera-mirrored video {
    transform: scaleX(-1) !important;
    -webkit-transform: scaleX(-1) !important;
}
</style>

<script src="~/lib/html5-qrcode/html5-qrcode.min.js"></script>
<script src="~/js/checkin-scanner.js"></script>
