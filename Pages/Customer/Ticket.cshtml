@page
@model BusGo.Pages.Customer.TicketModel
@{ ViewData["Title"] = Model.Ticket?.TicketCode ?? T("Chi tiết vé", "Ticket details"); }
<div class="page-header"><div><p class="eyebrow">@(Model.IsCounterStaff ? T("QUẦY VÉ", "TICKET COUNTER") : T("CHI TIẾT HÀNH TRÌNH", "JOURNEY DETAILS"))</p><h1>@(Model.Ticket?.IsPaid == true ? T("Vé điện tử", "Electronic ticket") : T("Thông tin đặt chỗ", "Reservation details"))</h1></div><a class="button secondary" asp-page="Tickets">@(Model.IsCounterStaff ? T("Vé do tôi lập", "Tickets I issued") : T("Vé của tôi", "My tickets"))</a></div>
@if (Model.Error is not null) { <div class="alert" role="alert">@Model.Error</div> }
@if (Model.Ticket is { } ticket)
{
@if (Model.Confirm == "cancel" && Model.CanCancel || Model.Confirm == "refund" && ticket.CanRequestRefund)
{
<section class="card"><h2>@(Model.Confirm == "refund" ? T("Gửi yêu cầu hoàn tiền?", "Submit a refund request?") : T("Hủy đặt chỗ này?", "Cancel this reservation?"))</h2><p>@T("Thao tác này hủy vé", "This cancels ticket") <strong>@ticket.TicketCode</strong> @T("và giải phóng ghế", "and releases seats") <strong>@ticket.SeatNumbers</strong>. @T("Không thể hoàn tác.", "This cannot be undone.")</p>@if (Model.Confirm == "refund") { <p>@T("Số tiền đã thanh toán:", "Amount paid:") @ticket.TotalPrice.ToString("N0") @T("đ", "VND"). @T("Nhà vận hành cần duyệt yêu cầu; gửi yêu cầu không đồng nghĩa tiền đã được hoàn.", "The operator must approve the request; submitting it does not mean the money has been refunded.")</p> }<form method="post" asp-page-handler="@(Model.Confirm == "refund" ? "Refund" : "Cancel")"><input type="hidden" asp-for="Id" /><input type="hidden" name="Confirmed" value="true" /><div class="actions"><button type="submit" class="button danger">@(Model.Confirm == "refund" ? T("Xác nhận yêu cầu hoàn tiền", "Confirm refund request") : T("Xác nhận hủy vé", "Confirm cancellation"))</button><a class="button secondary" asp-page="Ticket" asp-route-id="@ticket.TicketId">@T("Giữ lại vé", "Keep ticket")</a></div></form></section>
}
<article class="card ticket-card @(ticket.IsCancelled ? "ticket-cancelled" : ticket.IsUsed ? "ticket-used" : ticket.IsPaid ? "ticket-paid" : "ticket-pending")">
<div class="ticket-header"><div><p class="eyebrow">BUSGO@(string.IsNullOrWhiteSpace(ticket.CompanyName) ? "" : $" · {ticket.CompanyName}")</p><h2>@ticket.Route</h2><p class="ticket-reference">@T("Mã đặt chỗ", "Booking code") <strong class="ticket-code">@ticket.TicketCode</strong></p></div><div class="ticket-status"><span class="badge @(ticket.IsCancelled ? "status-cancelled" : ticket.IsPaid ? "status-paid" : "status-pending")">@Value(ticket.Status)</span><p>@Value(ticket.PaymentStatus)</p></div></div>
@if (ticket.IsCancelled) { <div class="alert">@T("Vé đã hủy và không còn giá trị sử dụng.", "This ticket has been cancelled and is no longer valid.")@if (ticket.PaymentStatus == TicketStatuses.Paid) { <span> @T("Yêu cầu hoàn tiền đang chờ nhà vận hành duyệt.", "The refund request is awaiting operator approval.")</span> }</div> }
else if (ticket.IsUsed) { <div class="alert">@T("Vé đã được sử dụng và không thể sử dụng lại.", "This ticket has been used and cannot be used again.")</div> }
else if (ticket.IsPaid) { <p class="ticket-boarding-note">@T("Vé đã thanh toán. Xuất trình vé điện tử tại điểm lên xe.", "This ticket is paid. Present your electronic ticket at the boarding point.")</p> }
else { <div class="alert">@T("Đang chờ thanh toán. Đây chưa phải vé lên xe đã thanh toán.", "Awaiting payment. This is not yet a paid boarding pass.")</div> }
<div class="ticket-meta"><dl><dt>@T("Khởi hành", "Departure")</dt><dd class="departure-time">@ticket.DepartureFormatted</dd><dt>@T("Đến nơi", "Arrival")</dt><dd>@ticket.ArrivalFormatted</dd><dt>@T("Hành khách", "Passenger")</dt><dd>@ticket.PassengerName</dd><dt>@T("Điện thoại", "Phone")</dt><dd>@ticket.PassengerPhone</dd><dt>@T("Ghế", "Seats")</dt><dd class="ticket-seat-number">@ticket.SeatNumbers <small>(@Format("{0} ghế", "{0} seats", ticket.SeatCount))</small></dd></dl><dl><dt>@T("Loại xe", "Bus type")</dt><dd>@Value(ticket.BusType) · @ticket.LicensePlate</dd><dt>@T("Tổng tiền", "Total")</dt><dd class="ticket-amount">@ticket.TotalPrice.ToString("N0") @T("đ", "VND")</dd><dt>@T("Ngày đặt", "Booked on")</dt><dd>@ticket.BookingTimeFormatted</dd><dt>@T("Thanh toán", "Payment")</dt><dd>@(ticket.PaymentMethod == "BankTransfer" ? T("Chuyển khoản VietQR", "VietQR bank transfer") : ticket.PaymentMethod == "Cash" ? T("Tiền mặt", "Cash") : Value(ticket.PaymentMethod))</dd>@if (ticket.RefundAmount > 0) { <dt>@T("Hoàn tiền", "Refund")</dt><dd>@ticket.TotalPrice.ToString("N0") @T("đ", "VND")</dd> }</dl></div>
@if (ticket.DiscountAmount > 0)
{
    <div class="notice">
        <p>@T("Giá vé gốc:", "Original fare:") @ticket.BaseFare.ToString("N0") @T("đ", "VND")</p>
        <p>@T("Ưu đãi thành viên:", "Membership discount:") <strong>@ticket.DiscountName</strong> @if (ticket.MembershipTier is { } tier) { <span>· @MembershipLabels.Display(tier)</span> } · −@ticket.DiscountAmount.ToString("N0") @T("đ", "VND")</p>
        <p>@T("Ưu đãi đã được lưu khi đặt vé; số tiền thanh toán trên vé không thay đổi khi chương trình kết thúc.", "This discount was saved when booking; the ticket amount does not change when the campaign ends.")</p>
    </div>
}
@if (ticket.IsPaid) { <div class="ticket-qr"><img src="@Url.Page("Ticket", "Qr", new { id = ticket.TicketId })" width="180" height="180" alt="@Format("Mã QR vé xe {0}", "Ticket QR code {0}", ticket.TicketCode)" /><div><p class="eyebrow">@T("VÉ ĐIỆN TỬ BUSGO", "BUSGO ELECTRONIC TICKET")</p><strong class="ticket-code">@ticket.TicketCode</strong><p class="muted">@T("Giữ mã vé để đối chiếu thông tin hành trình.", "Keep your ticket code to verify your journey details.")</p></div></div> }
</article>
@if (ticket.IsAwaitingPayment)
{
<section class="card payment-panel"><p class="eyebrow">@T("HOÀN TẤT ĐẶT CHỖ", "COMPLETE YOUR BOOKING")</p><h2>@T("Thanh toán", "Payment")</h2>@if (ticket.PaymentExpiresAt is { } deadline) { <p class="notice">@T("Hạn thanh toán:", "Payment deadline:") <strong>@deadline.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>. @T("Chỗ chưa thanh toán sẽ tự động được giải phóng sau thời hạn.", "Unpaid seats will be released automatically after this deadline.")</p> }
@if (ticket.PaymentMethod == "BankTransfer")
{
<div class="grid grid-2 payment-instructions"><div class="payment-qr"><img src="~/images/bank-transfer.jpg" width="280" alt="@T("Mã QR hướng dẫn chuyển khoản", "Bank transfer instruction QR code")" /></div><div><h3>@T("Chuyển khoản VietQR", "VietQR bank transfer")</h3><p>@T("Kiểm tra đúng người nhận trong ứng dụng ngân hàng trước khi chuyển.", "Verify the recipient in your banking app before transferring.")</p><p>@T("Chuyển chính xác", "Transfer exactly") <strong>@ticket.TotalPrice.ToString("N0") @T("đ", "VND")</strong>.</p><p>@T("Nội dung chuyển khoản:", "Transfer reference:") <strong class="ticket-code">@ticket.TicketCode</strong></p><p class="muted">@T("QR là ảnh tĩnh, BusGo chưa tự động đối soát. Nhà vận hành phải xác nhận đã nhận tiền. Không chuyển khoản lần hai nếu chưa kiểm tra giao dịch trước.", "This is a static QR image; BusGo does not automatically verify transfers. The operator must confirm receipt. Do not transfer again without checking your previous transaction.")</p><form method="post" asp-page-handler="Transfer"><input type="hidden" asp-for="Id" /><button class="button" type="submit">@T("Tôi đã chuyển khoản", "I have made the transfer")</button></form></div></div>
}
else if (ticket.PaymentMethod == "Cash") { <p>@T("Thanh toán", "Pay") <strong>@ticket.TotalPrice.ToString("N0") @T("đ", "VND")</strong> @T("cho nhà xe trên xe. Vé điện tử chỉ có sau khi nhà vận hành ghi nhận đã thu tiền.", "to the operator on board. An electronic ticket is available only after the operator records payment receipt.")</p> }
else if (string.IsNullOrEmpty(ticket.PaymentMethod)) { <form method="post" asp-page-handler="Payment" class="actions"><input type="hidden" asp-for="Id" /><div class="field"><label asp-for="PaymentMethod">@T("Chọn cách thanh toán", "Choose a payment method")</label><select asp-for="PaymentMethod"><option value="BankTransfer">@T("Chuyển khoản VietQR", "VietQR bank transfer")</option><option value="Cash">@T("Tiền mặt trên xe", "Cash on board")</option></select></div><button class="button" type="submit">@T("Bắt đầu thanh toán", "Start payment")</button></form> }
else { <p>@T("Đặt chỗ đang có phương thức thanh toán", "This reservation uses payment method") @Value(ticket.PaymentMethod). @T("Xem hướng dẫn tại", "See instructions in") <a asp-page="Help">@T("Trợ giúp", "Help")</a>.</p> }
<p><a class="button secondary" asp-page="Ticket" asp-route-id="@ticket.TicketId">@T("Làm mới trạng thái", "Refresh status")</a></p></section>
}
<section class="card ticket-management no-print"><p class="eyebrow">@(Model.IsCounterStaff ? T("THAO TÁC NHÂN VIÊN", "STAFF ACTIONS") : T("CÁC TÙY CHỌN CỦA BẠN", "YOUR OPTIONS"))</p><h2>@T("Quản lý vé", "Manage ticket")</h2><div class="actions">
@if (ticket.IsPaid) { <a class="button" asp-page="Ticket" asp-page-handler="Pdf" asp-route-id="@ticket.TicketId">@T("Tải PDF", "Download PDF")</a><a class="button secondary" asp-page="Ticket" asp-page-handler="Png" asp-route-id="@ticket.TicketId">@T("Tải PNG", "Download PNG")</a><button type="button" class="button secondary" data-print>@T("In vé", "Print ticket")</button> }
@if (!ticket.IsPaid && Model.IsCounterStaff) { <a class="button secondary" asp-page="/Admin/Payments" asp-route-Search="@ticket.TicketCode">@T("Quản lý thanh toán", "Payment management")</a> }
@if (Model.MapUrl is { } map) { <a class="button secondary" href="@map" target="_blank" rel="noopener noreferrer">@T("Xem bản đồ tuyến", "View route map")</a> }
<a class="button secondary" asp-page="Search" asp-route-Origin="@ticket.Origin" asp-route-Destination="@ticket.Destination">@(Model.IsCounterStaff ? T("Lập vé tuyến này", "Issue a ticket for this route") : T("Đặt lại tuyến", "Book this route again"))</a>
@if (Model.IsCounterStaff) { <a class="button secondary" asp-page="Search">@T("Bán vé cho khách tiếp theo", "Sell tickets to the next passenger")</a> }
@if (Model.CanCancel) { <a class="button danger" asp-page="Ticket" asp-route-id="@ticket.TicketId" asp-route-confirm="cancel">@T("Hủy đặt chỗ", "Cancel reservation")</a> }
@if (ticket.CanRequestRefund) { <a class="button danger" asp-page="Ticket" asp-route-id="@ticket.TicketId" asp-route-confirm="refund">@T("Yêu cầu hoàn tiền", "Request refund")</a> }
</div>
@if (ticket.IsPaid && !Model.IsCounterStaff) { <form method="post" asp-page-handler="Email"><input type="hidden" asp-for="Id" /><p class="muted">@Model.EmailNote</p><button class="button secondary" type="submit" disabled="@(!Model.CanEmail)">@T("Gửi vé PDF qua email", "Email PDF ticket")</button></form><noscript><p>@T("Dùng chức năng In của trình duyệt hoặc tải vé PDF.", "Use your browser's Print feature or download the PDF ticket.")</p></noscript> }
</section>
}
