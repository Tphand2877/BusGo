@page
@{ ViewData["Title"] = T("Trợ giúp đặt vé", "Booking help"); }
<div class="page-header"><div><p class="eyebrow">@T("HIỂU RÕ TRƯỚC KHI LÊN ĐƯỜNG", "KNOW BEFORE YOU GO")</p><h1>@T("Chúng tôi có thể", "How can")<br />@T("giải đáp điều gì?", "we help?")</h1><p class="muted">@T("Hướng dẫn đặt chỗ, thanh toán và quản lý vé trên BusGo.", "Guidance on booking, payment and managing tickets on BusGo.")</p></div></div>
<div class="help-layout">
    <aside class="help-sidebar">
        <p class="eyebrow">@T("HƯỚNG DẪN BUSGO", "BUSGO GUIDE")</p><h2>@T("Từng bước, rõ ràng.", "Clear guidance, step by step.")</h2>
        <p>@T("Từ khi chọn ghế đến lúc nhận vé, xem những điều cần biết cho hành trình của bạn.", "From choosing your seat to receiving your ticket, find out what you need to know for your journey.")</p>
        <a class="button" asp-page="Tickets">@T("Xem vé của tôi", "View my tickets")</a>
        <div class="help-disclosure" role="note"><strong>@T("Thông tin dịch vụ hiện tại", "Current service information")</strong><p>@T("BusGo chưa có tổng đài hỗ trợ chung 24/7, chưa tự đối soát ngân hàng và chưa bật thanh toán VNPay. Không chuyển tiền dựa trên dữ liệu từ trang tham khảo bên ngoài.", "BusGo does not currently have a shared 24/7 support hotline, does not automatically reconcile bank transfers and has not enabled VNPay payments. Do not transfer money based on information from external reference pages.")</p></div>
    </aside>
    <section class="faq-list" aria-labelledby="faq-heading">
        <p class="eyebrow">@T("CÂU HỎI THƯỜNG GẶP", "FREQUENTLY ASKED QUESTIONS")</p><h2 id="faq-heading">@T("Đặt vé & thanh toán", "Booking & payment")</h2>
        <details open><summary>@T("Làm thế nào để đặt chỗ và giữ ghế?", "How do I book and reserve a seat?")</summary><div><p>@T("Đăng nhập, chọn chuyến và ghế, kiểm tra lại thông tin hành khách rồi xác nhận. Ghế chỉ được giữ sau khi BusGo ghi nhận đặt chỗ thành công; hãy kiểm tra hạn thanh toán trên trang vé.", "Sign in, choose a trip and seats, review passenger details and confirm. Seats are only reserved after BusGo successfully records the booking; check the payment deadline on your ticket page.")</p></div></details>
        <details id="payment"><summary>@T("Tôi cần lưu ý gì khi chuyển khoản VietQR?", "What should I check when paying by VietQR bank transfer?")</summary><div><p>@T("QR chuyển khoản hiện là ảnh hướng dẫn tĩnh. Kiểm tra tên người nhận trong ứng dụng ngân hàng trước khi gửi, chuyển đúng số tiền và mã vé. Nhà xe/trạm phải xác nhận giao dịch; nút “Tôi đã chuyển khoản” chỉ gửi thông báo, không phải xác nhận thanh toán.", "The bank transfer QR is currently a static instruction image. Check the recipient's name in your banking app before sending, and use the exact amount and ticket code. The operator/station must confirm the transaction; the “I have transferred” button only sends a notification and does not confirm payment.")</p><p>@T("Nếu không chắc thông tin người nhận hoặc nội dung chuyển khoản, dừng giao dịch và liên hệ đơn vị vận hành qua kênh chính thức của họ.", "If you are unsure about the recipient details or transfer reference, stop the transaction and contact the operator through its official channels.")</p></div></details>
        <details><summary>@T("Có thể thanh toán tiền mặt không?", "Can I pay in cash?")</summary><div><p>@T("Chọn tiền mặt khi đặt chỗ và thanh toán trực tiếp với đơn vị vận hành theo hướng dẫn của vé. Vé chưa được xác nhận thanh toán không phải vé lên xe đã thanh toán.", "Choose cash when booking and pay the operator directly according to the instructions on your ticket. A ticket without confirmed payment is not a paid boarding ticket.")</p></div></details>
        <details id="cancellation"><summary>@T("Hủy vé và yêu cầu hoàn tiền như thế nào?", "How do I cancel a ticket and request a refund?")</summary><div><p>@T("Điều kiện hủy phụ thuộc trạng thái vé và giờ khởi hành. Với vé đã thanh toán, gửi yêu cầu hoàn tiền trên trang chi tiết vé; yêu cầu cần nhà vận hành xem xét và chấp thuận. Gửi yêu cầu không đồng nghĩa tiền đã được hoàn.", "Cancellation conditions depend on the ticket status and departure time. For paid tickets, submit a refund request on the ticket details page; the operator must review and approve it. Submitting a request does not mean the money has been refunded.")</p></div></details>
        <details><summary>@T("Vì sao tôi không tìm thấy chuyến?", "Why can't I find a trip?")</summary><div><p>@T("BusGo chỉ bán chuyến được nhà vận hành đăng trên chính hệ thống. Thông tin nhà xe và khung giờ có thể chưa đầy đủ; kiểm tra nguồn chính thức của nhà xe nếu cần thêm thông tin.", "BusGo only sells trips published by operators in its own system. Operator and schedule information may be incomplete; check the operator's official sources if you need more information.")</p><a asp-page="RouteGuides">@T("Xem tuyến tham khảo và nguồn →", "View reference routes and sources →")</a></div></details>
    </section>
</div>
<section class="card guide-cta"><div><p class="eyebrow">@T("SẴN SÀNG ĐI TIẾP?", "READY FOR YOUR NEXT JOURNEY?")</p><h2>@T("Tìm hành trình phù hợp với bạn.", "Find the right journey for you.")</h2><p class="muted">@T("Xem chuyến, giờ khởi hành và chỗ trống đang có trên BusGo.", "Browse trips, departure times and available seats on BusGo.")</p></div><a class="button" asp-page="Search">@T("Tìm chuyến BusGo", "Find BusGo trips")</a></section>
