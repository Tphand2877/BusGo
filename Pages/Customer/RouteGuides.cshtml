@page
@{ ViewData["Title"] = T("Cẩm nang tuyến xe", "Bus route guides"); }
<div class="page-header guide-heading"><div><p class="eyebrow">@T("CẢM HỨNG CHO CHUYẾN ĐI", "INSPIRATION FOR YOUR JOURNEY")</p><h1>@T("Cẩm nang tuyến xe", "Bus route guides")</h1><p class="muted">@T("Khám phá một số hành lang di chuyển qua nguồn tham khảo công khai. Đây không phải danh sách chuyến đang bán trên BusGo.", "Explore selected travel corridors using public reference sources. This is not a list of trips currently on sale on BusGo.")</p></div><span class="guide-label">@T("Góc tham khảo", "Reference corner")</span></div>
<div class="notice guide-notice" role="note"><strong>@T("Tham khảo trước, kiểm tra sau.", "Explore first, then verify.")</strong> @T("Lịch chạy, giá vé, điểm đón/trả và tình trạng ghế thay đổi theo ngày. BusGo chỉ nhận đặt chỗ cho chuyến trong kết quả tìm kiếm của chính BusGo; không nhập ghế, giá hoặc khuyến mại của nền tảng khác vào hệ thống bán vé.", "Schedules, fares, pickup/drop-off points and seat availability vary by date. BusGo only accepts bookings for trips in its own search results; seats, prices or promotions from other platforms are not imported into the ticketing system.")</div>
<div class="grid grid-2 guide-grid">
<article class="card"><div class="guide-card-photo"><img src="~/images/vietnam-bay.webp" alt="@T("Vịnh Hạ Long", "Ha Long Bay")" loading="lazy" /></div><p class="eyebrow">HÀ NỘI ↔ QUẢNG NINH</p><h2>Hà Nội – Hạ Long</h2><p>@T("Vexere đang giới thiệu tuyến Cửa Ông Limousine giữa Hà Nội và Hạ Long. Trang tuyến hiển thị 18 chuyến/ngày tại thời điểm cập nhật 01/10/2026; nhà xe và điểm đón/trả cụ thể phụ thuộc ngày đi.", "Vexere features the Cửa Ông Limousine route between Hà Nội and Hạ Long. The route page listed 18 trips per day when updated on 1 October 2026; the specific operator and pickup/drop-off points depend on the travel date.")</p><p class="muted">@T("Nguồn công khai: Vexere · Cửa Ông Limousine · cập nhật 01/10/2026.", "Public source: Vexere · Cửa Ông Limousine · updated 1 October 2026.")</p><div class="actions"><a class="button secondary" href="https://vexere.com/vi-VN/ve-xe-khach-cua-ong-limousine-tu-ha-noi-di-ha-long-quang-ninh-124t25541-19851.html" target="_blank" rel="noopener noreferrer">@T("Nguồn tham khảo VeXeRe ↗", "VeXeRe reference source ↗")</a><a asp-page="Search" asp-route-Origin="Hà Nội" asp-route-Destination="Hạ Long">@T("Tìm chuyến BusGo", "Find BusGo trips")</a></div></article>
<article class="card"><div class="guide-card-photo"><img src="~/images/vietnam-hanoi.jpg" alt="@T("Hà Nội Hải Phòng", "Hanoi Hai Phong")" loading="lazy" /></div><p class="eyebrow">HÀ NỘI ↔ HẢI PHÒNG</p><h2>Hà Nội – Hải Phòng</h2><p>@T("Trang nhà xe Hoàng Long trên redBus liệt kê tuyến Hà Nội – Hải Phòng và Hải Phòng – Hà Nội, gồm xe ghế ngồi và limousine. Đây là danh mục tham khảo từ một nền tảng bên ngoài, không xác nhận xe của nhà xe đang bán trên BusGo.", "The Hoàng Long operator page on redBus lists Hà Nội – Hải Phòng and Hải Phòng – Hà Nội routes, including seated buses and limousines. This is a reference catalog from an external platform and does not confirm that this operator's trips are on sale on BusGo.")</p><p class="muted">@T("Nguồn công khai: redBus Việt Nam · hồ sơ nhà xe Hoàng Long · kiểm tra 02/10/2026.", "Public source: redBus Vietnam · Hoàng Long operator profile · checked 2 October 2026.")</p><div class="actions"><a class="button secondary" href="https://www.redbus.vn/ve-xe-khach/nha-xe/hoang-long" target="_blank" rel="noopener noreferrer">@T("Nguồn tham khảo redBus ↗", "redBus reference source ↗")</a><a asp-page="Search" asp-route-Origin="Hà Nội" asp-route-Destination="Hải Phòng">@T("Tìm chuyến BusGo", "Find BusGo trips")</a></div></article>
<article class="card"><div class="guide-card-photo"><img src="~/images/vietnam-sapa.jpg" alt="@T("Sa Pa Lào Cai", "Sa Pa Lao Cai")" loading="lazy" /></div><p class="eyebrow">HÀ NỘI ↔ LÀO CAI</p><h2>Hà Nội – Sa Pa</h2><p>@T("Vexere có trang kết quả riêng cho tuyến Hà Nội – Sa Pa, với lựa chọn nhiều nhà xe và loại xe. Giá, thời gian và điểm dừng phải kiểm tra theo ngày khởi hành trên nguồn gốc.", "Vexere has a dedicated results page for the Hà Nội – Sa Pa route, offering a choice of operators and vehicle types. Check fares, times and stops for your departure date at the original source.")</p><p class="muted">@T("Nguồn công khai: Vexere · tuyến Hà Nội – Sa Pa · tham khảo 02/10/2026.", "Public source: Vexere · Hà Nội – Sa Pa route · consulted 2 October 2026.")</p><div class="actions"><a class="button secondary" href="https://vexere.com/vi-VN/ve-xe-khach-tu-ha-noi-di-sa-pa-lao-cai-124t24241.html/" target="_blank" rel="noopener noreferrer">@T("Nguồn tham khảo VeXeRe ↗", "VeXeRe reference source ↗")</a><a asp-page="Search" asp-route-Origin="Hà Nội" asp-route-Destination="Sa Pa">@T("Tìm chuyến BusGo", "Find BusGo trips")</a></div></article>
<article class="card"><div class="guide-card-photo"><img src="~/images/vietnam-dalat.jpg" alt="@T("Đà Lạt Lâm Đồng", "Da Lat Lam Dong")" loading="lazy" /></div><p class="eyebrow">TP. HỒ CHÍ MINH ↔ LÂM ĐỒNG</p><h2>TP. Hồ Chí Minh – Đà Lạt</h2><p>@T("Vexere có trang kết quả riêng cho tuyến TP. Hồ Chí Minh – Đà Lạt. Loại xe, giờ chạy, giá và tình trạng ghế là dữ liệu thay đổi theo chuyến, cần xem trực tiếp trên trang bán vé.", "Vexere has a dedicated results page for the TP. Hồ Chí Minh – Đà Lạt route. Vehicle types, departure times, fares and seat availability vary by trip and must be checked directly on the booking page.")</p><p class="muted">@T("Nguồn công khai: Vexere · tuyến TP. Hồ Chí Minh – Đà Lạt · tham khảo 02/10/2026.", "Public source: Vexere · TP. Hồ Chí Minh – Đà Lạt route · consulted 2 October 2026.")</p><div class="actions"><a class="button secondary" href="https://vexere.com/vi-VN/ve-xe-khach-tu-ho-chi-minh-di-da-lat-lam-dong-129t23991.html" target="_blank" rel="noopener noreferrer">@T("Nguồn tham khảo VeXeRe ↗", "VeXeRe reference source ↗")</a><a asp-page="Search" asp-route-Origin="Hồ Chí Minh" asp-route-Destination="Đà Lạt">@T("Tìm chuyến BusGo", "Find BusGo trips")</a></div></article>
</div>
<section class="card guide-cta"><div><p class="eyebrow">@T("TỪ Ý TƯỞNG ĐẾN HÀNH TRÌNH", "FROM INSPIRATION TO YOUR JOURNEY")</p><h2>@T("Tìm chuyến của bạn trên BusGo", "Find your trip on BusGo")</h2><p>@T("Chỉ tiếp tục đặt vé khi chuyến xe, giá, giờ chạy và chỗ trống được hiển thị trong BusGo. Nếu không tìm thấy, hệ thống chưa có chuyến được nhà vận hành đăng cho lựa chọn đó.", "Only proceed with booking when the trip, fare, departure time and available seats are shown on BusGo. If you cannot find a trip, no operator has published one in the system for that selection.")</p></div><a class="button" asp-page="Search">@T("Tìm chuyến đang mở bán", "Find trips on sale")</a></section>
